# docker compose 变量（docker compose 会自动读取本文件；shell 环境变量优先级更高）
# 注意：VERSION 需与 deploy/build.sh 产出的镜像 tag 保持一致

# 业务镜像 tag（docker build -t are-chat:$VERSION）
VERSION=1.8.0

# HTTP 端口（宿主机 → 容器 nginx 80）：唯一入口，浏览器访问与 PWA 都走它
# 公网服务器建议改回 80（浏览器可省略端口号）：APP_PORT=80
APP_PORT=50726

# —— HTTPS 方案（已备份到 deploy/nginx-https.conf，切回 HTTPS 时取消注释）——
# HTTPS 端口（宿主机 → 容器 nginx 443）：TLS 终止入口
# HTTPS_PORT=5443

DB_CONNECT_URL=jdbc:mariadb://are-chat-mariadb:3306/are_chat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_CONNECT_USER=are_chat
DB_CONNECT_PASSWORD=Ht@706706706
DB_CONNECT_DRIVER=org.mariadb.jdbc.Driver
