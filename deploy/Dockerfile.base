# ============================================================
# 基础镜像：Eclipse Temurin JDK 25 (JRE 运行时) + Ubuntu Noble 24.04
# - 25: JDK 主版本号（你后端需要的运行环境）
# - jre: 只含运行时，不含编译工具，镜像更小
# - noble: Ubuntu 24.04 LTS，包管理器是 apt
# ============================================================
FROM eclipse-temurin:25-jre-noble

# ============================================================
# 第一步：替换 apt 软件源为国内镜像（清华大学镜像站）
# 目的：加速 apt-get update 和 apt-get install 的下载速度
#
# 背景知识：
# - Ubuntu Noble 的源配置文件是 /etc/apt/sources.list.d/ubuntu.sources
#   （不是老版本的 /etc/apt/sources.list）
# - 该文件使用 DEB822 格式，里面包含 archive.ubuntu.com 和 security.ubuntu.com
# - 两个 sed 命令分别替换主仓库和安全仓库的地址
#
# ⚠️ 离线环境注意：删掉这段，直接用内部仓库的 base 镜像
# ============================================================
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/ubuntu.sources \
 && sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/ubuntu.sources

# ============================================================
# 第二步：安装 nginx + 清理 + 删除默认站点 + 创建配置目录 + 版本验证
#
# 逐条拆解：
# ============================================================
RUN apt-get update \
    # --------------------------------------------------------
    # 更新软件包索引（从镜像源拉取最新的包列表）
    # --------------------------------------------------------

 && apt-get install -y --no-install-recommends nginx \
    # --------------------------------------------------------
    # 安装 nginx
    # -y: 自动确认，无需交互
    # --no-install-recommends: 只装核心依赖，不装"推荐但非必需"的包
    #   → 显著减小镜像体积（大约省几十MB）
    # --------------------------------------------------------

 && rm -rf /var/lib/apt/lists/* \
    # --------------------------------------------------------
    # 删除 apt 缓存的包索引文件
    # 目的：减小镜像层体积
    # 这些缓存只在 apt-get update 时有用，安装完就没用了
    # 不删的话会白白占几MB~几十MB空间
    # --------------------------------------------------------

 && rm -f /etc/nginx/sites-enabled/default \
    # --------------------------------------------------------
    # 删除 nginx 默认站点符号链接
    # 背景：
    # - Ubuntu 的 nginx 包默认启用了一个 "default" 站点
    # - 它会占用 80 端口，和你后面自己写的 nginx.conf 冲突
    # - 删掉它，后面 COPY 自己的配置就不会端口冲突
    # --------------------------------------------------------

 && mkdir -p /etc/nginx/conf.d \
    # --------------------------------------------------------
    # 创建 nginx 额外配置目录
    # 背景：
    # - nginx 主配置 /etc/nginx/nginx.conf 里通常有这行：
    #     include /etc/nginx/conf.d/*.conf;
    # - 如果目录不存在，nginx 启动时会报错：
    #     nginx: [emerg] open() "/etc/nginx/conf.d/*.conf" failed
    # - 提前创建，确保 nginx 能正常启动
    # - 后面 Dockerfile 里 COPY nginx.conf 到这个目录
    # --------------------------------------------------------

 && java -version \
    # --------------------------------------------------------
    # 验证 JDK 安装是否成功
    # - 如果 java 不在 PATH 或版本不对，这步会失败，构建直接中断
    # - 相当于一个"冒烟测试"，确保 base 镜像里的 JDK 可用
    # - 输出会显示在 docker build 日志里，方便排查
    # --------------------------------------------------------

 && nginx -v
    # --------------------------------------------------------
    # 验证 nginx 安装是否成功
    # - 只打印版本号（如 nginx/1.24.0），不做其他事
    # - 同样作为冒烟测试，确保 nginx 装好了能跑
    # - 两个验证放在同一层，任何一步失败都会让构建中断
    # --------------------------------------------------------