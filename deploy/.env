# docker compose 变量（docker compose 会自动读取本文件；shell 环境变量优先级更高）
# 注意：VERSION 需与 deploy/build.sh 产出的镜像 tag 保持一致

# 业务镜像 tag（docker build -t are-chat:$VERSION）
VERSION=1.0.0

# HTTP 端口（宿主机 → 容器 nginx 80）：仅 301 跳转 HTTPS 与 ACME 证书续期挑战
APP_PORT=58080

# HTTPS 端口（宿主机 → 容器 nginx 443）：正式入口，浏览器访问与 PWA 安装都用它
# 公网服务器建议改回 443（浏览器可省略端口号）：HTTPS_PORT=443
HTTPS_PORT=5443
